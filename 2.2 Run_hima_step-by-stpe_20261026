    shp_file <- list.files(file.path(d, "1 shp"),      pattern="\\.shp$", full.names=TRUE)[1]
    npp_file <- list.files(file.path(d, "3 NPP-mean"), pattern="\\.tif$", full.names=TRUE)[1]
    fac_dir  <- file.path(d, "2 factors")
    aspect_f <- list.files(fac_dir, pattern="Aspect.*\\.tif$",    full.names=TRUE)[1]
    elev_f   <- list.files(fac_dir, pattern="elevation.*\\.tif$", full.names=TRUE)[1]
    slope_f  <- list.files(fac_dir, pattern="slope.*\\.tif$",     full.names=TRUE)[1]
    lc_f     <- list.files(fac_dir, pattern="MCD12Q1.*\\.tif$",   full.names=TRUE)[1]
