# build the unified source table: V1-V3 + V4-V8 (workshop layout)
build_src_list <- function() {
  src_list <- v123_sources
  for (d in list.dirs(ws, recursive = FALSE)) {
    if (!grepl("^[0-9]+ Hima", basename(d))) next
    vnum  <- as.integer(sub("^([0-9]+) .*", "\\1", basename(d)))
    hname <- sub("^[0-9]+ ", "", basename(d))
    tag   <- sprintf("V%d_%s", vnum, gsub(" ", "_", hname))
    src_list[[tag]] <- list(ws_dir = d)
  }
  src_list
}

