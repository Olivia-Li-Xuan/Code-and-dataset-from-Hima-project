    shp_file <- list.files(src$shp_dir, pattern="\\.shp$", full.names=TRUE)[1]
    npp_file <- list.files(src$npp_dir, pattern="CASA_NPP_Mean_2017_2025\\.tif$",
                           full.names=TRUE, recursive=TRUE)[1]
    fac_dir  <- src$fact_dir
    aspect_f <- list.files(fac_dir, pattern="WAPOR_Aspect.*\\.tif$",    full.names=TRUE)[1]
    elev_f   <- list.files(fac_dir, pattern="WAPOR_elevation.*\\.tif$", full.names=TRUE)[1]
