treat_npp <- matched_df %>% filter(status == 1) %>% arrange(subclass) %>% pull(CASA_NPP_2024)
control_npp <- matched_df %>% filter(status == 0) %>% arrange(subclass) %>% pull(CASA_NPP_2024)

paired_t_test <- t.test(treat_npp, control_npp, paired = TRUE)
print(paired_t_test)

mean_inside_real  <- mean(treat_npp, na.rm = TRUE)
mean_outside_real <- mean(control_npp, na.rm = TRUE)

plot_df <- as.data.frame(matched_df) %>%
  mutate(
    NPP_scaled = CASA_NPP_2024,
    Group = factor(status, 
                   levels = c(1, 0), 
                   labels = c("Inside", "Outside"))
  )

pair_df <- plot_df %>%
  dplyr::select(subclass, status, NPP_scaled) %>%
  pivot_wider(names_from = status, values_from = NPP_scaled, names_prefix = "status_") %>%
  rename(Inside = status_1, Outside = status_0) %>%
  mutate(
    Diff = Inside - Outside,
    Line_Color = ifelse(Diff > 0, "Higher (#002060)", "Lower (#ff6600)")
  )

n_higher <- sum(pair_df$Diff > 0, na.rm = TRUE)
n_lower  <- sum(pair_df$Diff < 0, na.rm = TRUE)
n_equal  <- sum(pair_df$Diff == 0, na.rm = TRUE)
total_pairs <- nrow(pair_df)

pct_higher <- sprintf("%.1f%%", (n_higher / total_pairs) * 100)
pct_lower  <- sprintf("%.1f%%", (n_lower / total_pairs) * 100)

plot_df_pairs <- plot_df %>%
  left_join(pair_df %>% dplyr::select(subclass, Line_Color), by = "subclass")

t_val_scaled_estimate <- paired_t_test$estimate
p_val_text <- ifelse(paired_t_test$p.value < 0.001, 
                     "p < 0.001 ***", 
                     paste0("p = ", round(paired_t_test$p.value, 4)))

diff_text <- paste0("Mean Diff: ", sprintf("%.2f", t_val_scaled_estimate), " g/m²/yr")
label_text <- paste0("Paired t-test: ", p_val_text, " | ", diff_text, 
                     "\nInside > Outside: ", n_higher, " (", pct_higher, 
                     ")  |  Inside < Outside: ", n_lower, " (", pct_lower, ")")

y_max <- max(plot_df_pairs$NPP_scaled, na.rm = TRUE)

p_bar <- ggplot(plot_df_pairs, aes(x = Group, y = NPP_scaled)) +
  
  stat_summary(
    fun = mean, 
    geom = "bar", 
    aes(fill = Group), 
    width = 0.5, 
    alpha = 0.5,
    color = "gray50",
    linewidth = 0.1
  ) +
  
  stat_summary(
    fun.data = mean_se, 
    geom = "errorbar", 
    width = 0.15, 
    color = "black", 
    linewidth = 0.1
  ) +
  
  scale_fill_manual(values = c("Inside" = "#002060", "Outside" = "#ff6600")) +
  
  annotate(
    "text",
    x = 1,
    y = y_max * 0.98,
    label = paste0("Mean: ", sprintf("%.2f", mean_inside_real), " g/m²/yr"),
    color = "#002060",
    fontface = "bold",
    size = 2.2
  ) +
  annotate(
    "text",
    x = 2,
    y = y_max * 0.98,
    label = paste0("Mean: ", sprintf("%.2f", mean_outside_real), " g/m²/yr"),
    color = "#d95f02",
    fontface = "bold",
    size = 2.2
  ) +
  
  labs(
    title = NULL,
    subtitle = NULL,
    caption = label_text,
    x = NULL,
    y = expression("Net Primary Production (g C/m"^2*"/yr)")
  ) +
  
  theme_bw(base_size = 13) +
  theme(
    plot.title = element_blank(),
    plot.subtitle = element_blank(),
    
    plot.caption = element_text(
      hjust = 0.5,
      size = 6,
      color = "#002060",
      face = "bold",
      lineheight = 1.2,
      margin = margin(t = 6)
    ),
    
    axis.title = element_text(size = 7, face = "bold"),
    axis.text.y = element_text(size = 6, color = "black", angle = 90),
    axis.text.x = element_text(size = 6, color = "black"),
    legend.position = "none",
    panel.grid.major = element_blank(),
    panel.grid.minor = element_blank()
  )

print(p_bar)
ggsave(
  "G:/5 David Eldridge/1 Tasks-20260805/Spatial_Matched_CASA2024.png", 
  plot = p_bar, 
  width = 7.66, 
  height = 6.9, 
  units = "cm", 
  dpi = 1000
)

