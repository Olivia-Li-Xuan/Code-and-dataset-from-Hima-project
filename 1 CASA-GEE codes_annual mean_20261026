var geom = geometry.geometry();

var areaScaleFactor = 5;

var origCentroid = geom.centroid(1);
var origArea = geom.area(1);

var targetArea = origArea.multiply(areaScaleFactor);
var sideLength = targetArea.sqrt();
var halfSide = sideLength.divide(2);

var studyArea = origCentroid.buffer(halfSide, 1).bounds(1);

print('Original Area (sq km):', origArea.divide(1e6));
print('Expanded Square Area (sq km):', studyArea.area(1).divide(1e6));
print('Actual Area Scale Factor:', studyArea.area(1).divide(origArea));
print('Is original SHP contained?:', studyArea.contains(geom, 1));

Map.centerObject(studyArea, 10);

Map.addLayer(studyArea, {color: '0000FF'}, 'Expanded Square Study Area (' + areaScaleFactor + 'x)');
Map.addLayer(geometry, {color: 'FF0000'}, 'Original SHP Boundary');

var startYear = 2017;
var endYear = 2025;

var landsatScale = 30;

var PAR_fraction = 0.47;

var landsatCollection = ee.ImageCollection("LANDSAT/LC08/C02/T1_L2")
  .merge(ee.ImageCollection("LANDSAT/LC09/C02/T1_L2"))
  .filterBounds(studyArea);

function maskLandsatC2(image){
  var qa = image.select('QA_PIXEL');

  var cloudMask = qa.bitwiseAnd(1 << 1).eq(0)
    .and(qa.bitwiseAnd(1 << 3).eq(0))
    .and(qa.bitwiseAnd(1 << 4).eq(0))
    .and(qa.bitwiseAnd(1 << 5).eq(0));

  var saturationMask = image.select('QA_RADSAT').eq(0);

  var opticalBands = image.select([
    'SR_B2', 'SR_B3', 'SR_B4', 'SR_B5', 'SR_B6', 'SR_B7'
  ])
  .multiply(0.0000275)
  .add(-0.2)
  .rename([
    'Blue', 'Green', 'Red', 'NIR', 'SWIR1', 'SWIR2'
  ]);

  return opticalBands
    .updateMask(cloudMask)
    .updateMask(saturationMask)
    .copyProperties(image, ['system:time_start', 'LANDSAT_PRODUCT_ID']);
}

var landsatSR = landsatCollection
  .map(maskLandsatC2)
  .filter(ee.Filter.calendarRange(startYear, endYear, 'year'));

print('Processed Landsat collection', landsatSR);

function addNDVI(image){
  var ndvi = image.normalizedDifference(['NIR', 'Red']).rename('NDVI');
  return image.addBands(ndvi);
}

var landsatNDVI = landsatSR.map(addNDVI);

var era5Monthly = ee.ImageCollection("ECMWF/ERA5_LAND/MONTHLY_AGGR")
  .filterBounds(studyArea)
  .filter(ee.Filter.calendarRange(startYear, endYear, 'year'));

var modisLC = ee.ImageCollection("MODIS/061/MCD12Q1")
  .filter(ee.Filter.calendarRange(startYear, endYear, 'year'))
  .select('LC_Type1');

var isUnchanged = modisLC.reduce(ee.Reducer.countDistinct()).eq(1);

var unchangedLandCover = modisLC.mode()
  .updateMask(isUnchanged)
  .clip(studyArea);

var Topt = ee.Image(0)
  .where(unchangedLandCover.gte(1).and(unchangedLandCover.lte(5)), 25)
  .where(unchangedLandCover.gte(6).and(unchangedLandCover.lte(7)), 22)
  .where(unchangedLandCover.gte(8).and(unchangedLandCover.lte(9)), 23)
  .where(unchangedLandCover.eq(10), 20)
  .where(unchangedLandCover.eq(11), 24)
  .where(unchangedLandCover.eq(12), 22)
  .where(unchangedLandCover.eq(13), 20)
  .where(unchangedLandCover.eq(14), 22)
  .where(unchangedLandCover.eq(16), 18)
  .rename('Topt');

function monthlyNDVI(year, month){
  var start = ee.Date.fromYMD(year, month, 1);
  var end = start.advance(1, 'month');

  var monthlyCollection = landsatNDVI
    .filterDate(start, end)
    .select('NDVI');

  var count = monthlyCollection.size();

  var ndvi = ee.Image(
    ee.Algorithms.If(
      count.gt(0),
      monthlyCollection.median().rename('NDVI'),
      ee.Image.constant(0).rename('NDVI').updateMask(ee.Image(0))
    )
  );

  return ndvi.set({
    'year': year,
    'month': month,
    'system:time_start': start.millis(),
    'image_count': count
  });
}

var years = ee.List.sequence(startYear, endYear);
var months = ee.List.sequence(1, 12);

var monthlyNDVICollection = ee.ImageCollection(
  years.map(function(y){
    return months.map(function(m){
      return monthlyNDVI(y, m);
    });
  }).flatten()
);

var ndviPercentile = monthlyNDVICollection
  .select('NDVI')
  .reduce(ee.Reducer.percentile([5, 95]));

var NDVImin = ndviPercentile.select('NDVI_p5');
var NDVImax = ndviPercentile.select('NDVI_p95');

function calculateFPAR(image){
  var ndvi = image.select('NDVI');

  var fpar = ndvi
    .subtract(NDVImin)
    .divide(NDVImax.subtract(NDVImin))
    .multiply(0.949)
    .add(0.001)
    .clamp(0.001, 0.95)
    .rename('FPAR');

  return image.addBands(fpar);
}

var monthlyFPAR = monthlyNDVICollection.map(calculateFPAR);

function monthlyPAR(image){
  var date = ee.Date(image.get('system:time_start'));

  var era = era5Monthly
    .filterDate(date, date.advance(1, 'month'))
    .first();

  var solar = era
    .select('surface_solar_radiation_downwards_sum')
    .multiply(1e-6)
    .rename('SOL_MJ');

  var par = solar
    .multiply(PAR_fraction)
    .rename('PAR');

  return image.addBands(par);
}

var monthlyPARCollection = monthlyFPAR.map(monthlyPAR);

function temperatureStress(image){
  var date = ee.Date(image.get('system:time_start'));

  var era = era5Monthly
    .filterDate(date, date.advance(1, 'month'))
    .first();

  var temp = era
    .select('temperature_2m')
    .subtract(273.15);

  var t1 = temp
    .multiply(-0.0005)
    .multiply(temp)
    .add(temp.multiply(0.01))
    .add(0.8)
    .clamp(0, 1);

  var t2 = ee.Image(1)
    .divide(
      ee.Image(1).add(
        temp.subtract(Topt).abs().multiply(0.2).exp()
      )
    )
    .multiply(2);

  var tStress = t1.multiply(t2).clamp(0, 1).rename('Tstress');

  return image.addBands(tStress);
}

var monthlyTStress = monthlyPARCollection.map(temperatureStress);

function waterStress(image){
  var date = ee.Date(image.get('system:time_start'));

  var era = era5Monthly
    .filterDate(date, date.advance(1, 'month'))
    .first();

  var aet = era.select('total_evaporation_sum').abs();
  var pet = era.select('potential_evaporation_sum').abs();

  var w = aet
    .divide(pet.add(0.001))
    .clamp(0, 1)
    .rename('Wstress');

  return image.addBands(w);
}

var monthlyStress = monthlyTStress.map(waterStress);

var epsilonMax = ee.Image(0)
  .where(unchangedLandCover.gte(1).and(unchangedLandCover.lte(5)), 0.80)
  .where(unchangedLandCover.gte(6).and(unchangedLandCover.lte(7)), 0.45)
  .where(unchangedLandCover.gte(8).and(unchangedLandCover.lte(9)), 0.50)
  .where(unchangedLandCover.eq(10), 0.55)
  .where(unchangedLandCover.eq(11), 0.60)
  .where(unchangedLandCover.eq(12), 0.55)
  .where(unchangedLandCover.eq(13), 0.05)
  .where(unchangedLandCover.eq(14), 0.55)
  .where(unchangedLandCover.eq(16), 0.05)
  .rename('epsilonMax')
  .clip(studyArea);

function calculateMonthlyNPP(image){
  var par = image.select('PAR');
  var fpar = image.select('FPAR');
  var t = image.select('Tstress');
  var w = image.select('Wstress');

  var npp = par
    .multiply(fpar)
    .multiply(t)
    .multiply(w)
    .multiply(epsilonMax)
    .rename('NPP_month');

  return image.addBands(npp);
}

var monthlyNPP = monthlyStress.map(calculateMonthlyNPP);

function annualNPP(year){
  year = ee.Number(year);
  var start = ee.Date.fromYMD(year, 1, 1);
  var end = start.advance(1, 'year');

  var annualCollection = monthlyNPP
    .filterDate(start, end)
    .select('NPP_month');

  var monthCount = annualCollection.count();

  var annual = annualCollection.sum().rename('NPP');

  annual = annual.updateMask(monthCount.gte(10));

  return annual.set({
    'year': year,
    'valid_months': monthCount,
    'system:time_start': start.millis()
  });
}

var annualNPPCollection = ee.ImageCollection(years.map(annualNPP));

var meanNPP = annualNPPCollection.select('NPP').mean().rename('NPP_mean');

print('Multi-year Mean NPP (2024-2025):', meanNPP);

Map.addLayer(
  meanNPP,
  {min: 0, max: 500, palette: ['ffffff', 'ffff00', '008000']},
  'CASA Mean NPP (2017-2025)'
);

Export.image.toDrive({
  image: meanNPP,
  description: 'CASA_NPP_Mean_2017_2025',
  folder: 'CASA_NPP_Exports',
  fileNamePrefix: 'CASA_NPP_Mean_2017_2025',
  region: studyArea,
  scale: landsatScale,
  crs: 'EPSG:4326',
  maxPixels: 1e13
});
