# ---------------------------------------------------------------------------
# Helper: variance inflation factors (no extra package needed)
# ---------------------------------------------------------------------------
vif_manual <- function(d) {
  vars <- names(d)
  out <- sapply(vars, function(v) {
    others <- setdiff(vars, v)
    if (!length(others)) return(NA_real_)
    f <- as.formula(paste(v, "~", paste(others, collapse = " + ")))
    r2 <- tryCatch(summary(lm(f, data = d))$r.squared, error = function(e) NA_real_)
    if (is.na(r2) || r2 >= 0.999999) return(NA_real_)
    1 / (1 - r2)
  })
  out
}

# ---------------------------------------------------------------------------
# adaptive boundary-band width : narrowest width of the Hima (metres)
# rotating-caliper minimum width on the convex hull, projected to a local
# azimuthal-equidistant CRS so distances are in metres and zone-independent.
# The boundary band on each side may not exceed 1/3 of this width; the default
# 100 m is kept unless the Hima is narrower than 3 * 100 m.
# ---------------------------------------------------------------------------
compute_min_width_m <- function(poly_ll) {
  cc  <- crds(centroids(poly_ll))[1, ]                       # lon0, lat0
  aeqd <- paste0("+proj=aeqd +lat_0=", cc[2], " +lon_0=", cc[1],
                 " +datum=WGS84 +units=m +no_defs")
  poly_m <- project(poly_ll, aeqd)
  hull   <- suppressWarnings(convHull(poly_m))                # convex hull (handles holes / multipart)
  pts    <- crds(hull); pts <- pts[!duplicated(round(pts, 2)), , drop = FALSE]
  if (!is.matrix(pts) || nrow(pts) < 3) pts <- crds(poly_m)
  pts    <- pts[!duplicated(round(pts, 2)), , drop = FALSE]
  if (nrow(pts) < 3) return(NA_real_)
  angles <- seq(0, 180, by = 0.5) * pi / 180
  best   <- Inf
  for (a in angles) {
    u   <- c(cos(a), sin(a))
    pr  <- pts %*% u
    w   <- max(pr) - min(pr)
    if (w < best) best <- w
  }
  best
}

# ---------------------------------------------------------------------------
# STEP 1 : pre-match review of covariates and MatchIt parameters
# ---------------------------------------------------------------------------
review_design <- function(df, ps_vars, exact_var, treat_var) {
  lines <- character(0)
  add <- function(...) lines <<- c(lines, sprintf(...))

  n_t <- sum(df[[treat_var]] == 1)
  n_c <- sum(df[[treat_var]] == 0)

  add("---- 1. COVARIATE REVIEW -------------------------------------")
  add("PS model covariates: %s", paste(ps_vars, collapse = ", "))
  add("Exact-matching stratum: %s", exact_var)

  # a) role of each variable (confounder / mediator / collider)
  for (v in ps_vars) {
    if (v %in% pre_treatment_vars) {
      add("  [OK] %-10s : pre-treatment topographic variable -> valid confounder", v)
    } else if (v %in% post_treatment_risk) {
      add("  [!!] %-10s : may be affected by treatment -> mediator risk, REMOVE from PS model", v)
    } else {
      add("  [??] %-10s : role not documented, check manually", v)
    }
  }
  if (exact_var %in% post_treatment_risk) {
    add("  [NOTE] %s is kept only as an exact-matching stratum and is NOT in the",
        exact_var)
    add("         PS model. That is the correct way to use a possible mediator:")
    add("         within-stratum comparison avoids mediator / collider bias.")
  }
  # outcome leakage check
  if (any(grepl("NPP", ps_vars, ignore.case = TRUE))) {
    add("  [!!] outcome-derived variable detected in the PS model -> must be removed")
  } else {
    add("  [OK] no outcome (NPP) variable enters the PS model")
  }

  # b) collinearity among covariates (sampled for speed)
  samp_n <- min(nrow(df), 200000)
  ds <- df[sample(nrow(df), samp_n), , drop = FALSE]
  num_vars <- ps_vars[sapply(ds[ps_vars], is.numeric)]
  num_vars <- num_vars[!grepl("I\\(|:", num_vars)]     # drop polynomial/interaction terms
  if (length(num_vars) > 1) {
    cm <- cor(ds[num_vars], use = "pairwise.complete.obs")
    add("")
    add("  Correlation matrix (|r|>0.80 flagged):")
    hi <- which(abs(cm) > 0.80 & upper.tri(cm), arr.ind = TRUE)
    for (i in seq_len(nrow(hi))) {
      add("    [!!] %s ~ %s : r = %.2f", num_vars[hi[i, 1]], num_vars[hi[i, 2]],
          cm[hi[i, 1], hi[i, 2]])
    }
    if (!nrow(hi)) add("    [OK] no pair with |r| > 0.80")
    vifs <- vif_manual(ds[num_vars])
    add("  VIF: %s", paste(sprintf("%s=%.2f", names(vifs), vifs), collapse = ", "))
    if (any(vifs > 5, na.rm = TRUE)) {
      add("    [!!] VIF > 5 -> collinearity, but polynomial terms are collinear by")
      add("         construction; monitor variance ratios, do not drop blindly")
    } else {
      add("    [OK] all VIF <= 5")
    }
  }

  # c) parameter / sample-size adequacy
  add("")
  add("---- 2. PARAMETER REVIEW -------------------------------------")
  add("  Sample: treated (Inside) = %s, control (Outside) = %s, ratio C/T = %.1f",
      format(n_t, big.mark = ","), format(n_c, big.mark = ","), n_c / n_t)
  add("  method = nearest, distance = glm (logistic PS), replace = FALSE, ratio = 1")
  if (n_c / n_t >= 5) {
    add("  [OK] controls are abundant -> ratio = 1 is feasible; a larger ratio")
    add("       would reduce variance and is kept as a remediation option")
  } else if (n_c / n_t < 2) {
    add("  [!!] few controls per treated unit -> ratio > 1 is NOT feasible,")
    add("       replace = TRUE is kept as the remediation option")
  }
  add("  caliper = 0.25 SD of the PS (+ Slope-specific caliper 0.3): standard")
  add("  practice is 0.20 SD; because N is large here the caliper mainly")
  add("  controls bias, tightening it is a valid remediation step.")
  add("  [NOTE] squared terms I(Elevation^2), I(Slope^2) are already included to")
  add("         absorb non-linear PS specification; interactions are added only")
  add("         if diagnostics show residual imbalance.")
  add("")
  lines
}

# ---------------------------------------------------------------------------
# STEP 2 : post-match diagnostics
# ---------------------------------------------------------------------------
overlap_coef <- function(a, b, n = 512) {
  a <- a[is.finite(a)]; b <- b[is.finite(b)]
  if (length(a) < 10 || length(b) < 10) return(NA_real_)
  x <- seq(min(c(a, b)), max(c(a, b)), length.out = n)
  d1 <- density(a, n = n); d2 <- density(b, n = n)
  y1 <- approx(d1$x, d1$y, xout = x, rule = 2)$y
  y2 <- approx(d2$x, d2$y, xout = x, rule = 2)$y
  y1[is.na(y1)] <- 0; y2[is.na(y2)] <- 0
  if (sum(pmax(y1, y2)) == 0) return(NA_real_)
  sum(pmin(y1, y2)) / sum(pmax(y1, y2))
}

diagnose_match <- function(m, tag, round_i, spec, out_dir) {
  s <- summary(m, standardize = TRUE, interactions = FALSE)
  get_col <- function(d, pat) {
    nm <- grep(pat, colnames(d), value = TRUE, ignore.case = TRUE)
    if (!length(nm)) return(rep(NA_real_, nrow(d)))
    as.numeric(d[[nm[1]]])
  }
  sa <- as.data.frame(s$sum.all)
  sm <- as.data.frame(s$sum.matched)

  bal <- data.frame(
    variable    = rownames(sm),
    SMD_before  = get_col(sa, "Std. Mean Diff"),
    SMD_after   = get_col(sm, "Std. Mean Diff"),
    VR_before   = get_col(sa, "Var. Ratio"),
    VR_after    = get_col(sm, "Var. Ratio"),
    stringsAsFactors = FALSE
  )
  bal <- bal[!is.na(bal$SMD_after), ]
  bal$is_distance <- bal$variable == "distance"

  # covariate balance (propensity score itself reported separately)
  cov_bal <- bal[!bal$is_distance, ]
  max_smd_b <- max(abs(cov_bal$SMD_before), na.rm = TRUE)
  max_smd_a <- max(abs(cov_bal$SMD_after),  na.rm = TRUE)
  n_bad_smd <- sum(abs(cov_bal$SMD_after) > SMD_OK, na.rm = TRUE)
  bad_vars  <- cov_bal$variable[abs(cov_bal$SMD_after) > SMD_OK]

  vr_a <- cov_bal$VR_after[is.finite(cov_bal$VR_after) & cov_bal$VR_after > 0]
  vr_min <- if (length(vr_a)) min(vr_a) else NA_real_
  vr_max <- if (length(vr_a)) max(vr_a) else NA_real_
  n_bad_vr <- sum(vr_a < VR_LOW | vr_a > VR_HIGH)

  # sample accounting
  w  <- m$weights
  tt <- m$treat == 1
  n_t <- sum(tt); n_c <- sum(!tt)
  t_kept <- sum(w > 0 & tt); c_kept <- sum(w > 0 & !tt)
  loss_t <- 1 - t_kept / n_t
  loss_c <- 1 - c_kept / n_c

  # propensity score / common support
  ps <- m$distance
  ov_before <- overlap_coef(ps[tt], ps[!tt])
  ov_after  <- overlap_coef(ps[tt & w > 0], ps[!tt & w > 0])
  lo <- max(min(ps[tt]),  min(ps[!tt]))
  hi <- min(max(ps[tt]),  max(ps[!tt]))
  in_support <- if (hi > lo) mean(ps[tt] >= lo & ps[tt] <= hi) else 0

  pass_smd  <- n_bad_smd == 0
  pass_vr   <- n_bad_vr == 0
  pass_loss <- loss_t <= LOSS_MAX
  pass_all  <- pass_smd && pass_vr && pass_loss

  # ---- artefacts -----------------------------------------------------------
  bal$round <- round_i
  write.csv(bal, file.path(out_dir, paste0(tag, "_balance_round", round_i, ".csv")),
            row.names = FALSE)

  love <- bal %>%
    select(variable, before = SMD_before, after = SMD_after) %>%
    pivot_longer(cols = c(before, after), names_to = "stage", values_to = "SMD") %>%
    mutate(stage = factor(stage, levels = c("before", "after"),
                          labels = c("Before matching", "After matching")))
  p_love <- ggplot(love, aes(x = SMD, y = variable, group = variable)) +
    geom_vline(xintercept = c(-SMD_OK, SMD_OK), linetype = "dashed", color = "grey40") +
    geom_vline(xintercept = 0, color = "grey70") +
    geom_line(color = "grey60") +
    geom_point(aes(shape = stage, color = stage), size = 1.8) +
    scale_color_manual(values = c("Before matching" = "#ff6600", "After matching" = "#002060")) +
    scale_shape_manual(values = c("Before matching" = 1, "After matching" = 19)) +
    labs(x = "Standardized mean difference", y = NULL,
         title = paste0(tag, "  round ", round_i, "  |  max|SMD| after = ",
                        sprintf("%.3f", max_smd_a))) +
    theme_bw(base_size = 9) +
    theme(legend.title = element_blank(),
          legend.position = "bottom",
          panel.grid.minor = element_blank())
  ggsave(file.path(out_dir, paste0(tag, "_LovePlot_round", round_i, ".png")),
         plot = p_love, width = 12, height = max(5, 1.2 + 0.35 * nrow(bal)),
         units = "cm", dpi = 400)

  samp <- function(x, k = 200000) if (length(x) > k) sample(x, k) else x
  ps_df <- rbind(
    data.frame(stage = "Before matching",
               ps = samp(ps[tt]), group = "Inside"),
    data.frame(stage = "Before matching",
               ps = samp(ps[!tt]), group = "Outside"),
    data.frame(stage = "After matching",
               ps = samp(ps[tt & w > 0]), group = "Inside"),
    data.frame(stage = "After matching",
               ps = samp(ps[!tt & w > 0]), group = "Outside"))
  p_ps <- ggplot(ps_df, aes(x = ps, fill = group)) +
    geom_density(alpha = 0.45, color = NA) +
    facet_wrap(~ stage, scales = "free_y") +
    scale_fill_manual(values = c("Inside" = "#002060", "Outside" = "#ff6600")) +
    labs(x = "Propensity score", y = "Density",
         title = paste0(tag, "  round ", round_i,
                        "  |  overlap before = ", sprintf("%.2f", ov_before),
                        "   overlap after = ", sprintf("%.2f", ov_after))) +
    theme_bw(base_size = 9) +
    theme(legend.title = element_blank(), panel.grid.minor = element_blank())
  ggsave(file.path(out_dir, paste0(tag, "_PSdistribution_round", round_i, ".png")),
         plot = p_ps, width = 14, height = 7, units = "cm", dpi = 400)

  list(
    round          = round_i,
    spec           = spec,
    balance        = bal,
    max_smd_before = max_smd_b,
    max_smd_after  = max_smd_a,
    n_bad_smd      = n_bad_smd,
    bad_vars       = bad_vars,
    vr_min         = vr_min,
    vr_max         = vr_max,
    n_bad_vr       = n_bad_vr,
    overlap_before = ov_before,
    overlap_after  = ov_after,
    pct_in_support = in_support,
    n_treated      = n_t,
    n_control      = n_c,
    n_matched      = sum(w > 0),
    loss_treated   = loss_t,
    loss_control   = loss_c,
    pass_smd       = pass_smd,
    pass_vr        = pass_vr,
    pass_loss      = pass_loss,
    pass_all       = pass_all
  )
}

# ---------------------------------------------------------------------------
# diagnostic report text for one round
# ---------------------------------------------------------------------------
diag_text <- function(dg) {
  c(
    sprintf("  Round %d  --  %s", dg$round, dg$spec$label),
    sprintf("      PS formula : %s", paste(deparse(dg$spec$formula), collapse = "")),
    sprintf("      exact = %s | method = %s | distance = %s | caliper = %s | ratio = %d | replace = %s",
            paste(deparse(dg$spec$exact), collapse = ""), dg$spec$method, dg$spec$distance,
            paste(dg$spec$caliper, collapse = ", "), dg$spec$ratio, dg$spec$replace),
    sprintf("      max |SMD| before = %.3f  ->  after = %.3f   (%s)",
            dg$max_smd_before, dg$max_smd_after,
            ifelse(dg$pass_smd, "PASS, all < 0.10",
                   paste0("FAIL, unbalanced: ", paste(dg$bad_vars, collapse = ", ")))),
    sprintf("      variance ratio after : min = %.2f, max = %.2f   (%s)",
            dg$vr_min, dg$vr_max,
            ifelse(dg$pass_vr, "PASS, within 0.50-2.00", "FAIL, outside 0.50-2.00")),
    sprintf("      PS overlap : before = %.2f, after = %.2f ; treated inside common support = %.1f%%",
            dg$overlap_before, dg$overlap_after, 100 * dg$pct_in_support),
    sprintf("      sample : treated %s / control %s ; matched %s ; dropped treated %.1f%%, dropped control %.1f%%   (%s)",
            format(dg$n_treated, big.mark = ","), format(dg$n_control, big.mark = ","),
            format(dg$n_matched, big.mark = ","), 100 * dg$loss_treated,
            100 * dg$loss_control,
            ifelse(dg$pass_loss, "PASS", "FAIL, >25% of treated units lost")),
    sprintf("      VERDICT : %s", ifelse(dg$pass_all, "ACCEPTED", "NOT ACCEPTED"))
  )
}

